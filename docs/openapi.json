{
    "openapi": "3.1.0",
    "info": {
        "title": "API de Gestao de Usuarios - Restaurantes",
        "description": "Sistema compartilhado de gestao para restaurantes - Fase 1.\n\nContempla o cadastro de usuarios em dois tipos (cliente e dono de restaurante), atualizacao de dados, troca de senha em endpoint proprio, busca por nome e validacao de credenciais.\n\n**Versionamento:** a versao integra o caminho da rota (/api/v1/...). Alteracoes compativeis - como a inclusao de um campo na resposta - permanecem na versao corrente. Apenas mudancas que quebram consumidores existentes originam uma nova versao, como ocorre em /api/v2/usuarios, cuja busca por nome devolve um objeto paginado no lugar de uma lista.\n\n**Erros:** todas as respostas de erro seguem a RFC 7807 (ProblemDetail).",
        "contact": {
            "name": "Thiago Wippel Chaves",
            "email": "thiagowippel@hotmail.com"
        },
        "license": {
            "name": "Uso academico - FIAP Pos Tech"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost:8080",
            "description": "Generated server url"
        }
    ],
    "tags": [
        {
            "name": "Usuarios",
            "description": "Cadastro, consulta, atualizacao e exclusao de usuarios"
        },
        {
            "name": "Autenticacao",
            "description": "Validacao de login e senha"
        },
        {
            "name": "Usuarios v2",
            "description": "Busca de usuarios com paginacao"
        }
    ],
    "paths": {
        "/api/v1/usuarios/{id}": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Consulta um usuario pelo identificador",
                "operationId": "buscarPorId",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Identificador do usuario",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Usuario encontrado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuario inexistente",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "https://github.com/ThiagoWippel/fiap-adj-tech-challenge-fase-1/blob/main/README.md#recurso-nao-encontrado",
                                    "title": "Recurso nao encontrado",
                                    "status": 404,
                                    "detail": "Usuario nao encontrado para o id 99",
                                    "instance": "/api/v1/usuarios/99",
                                    "momento": "2026-08-21T10:30:00"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Atualiza os dados de um usuario",
                "description": "Atualiza nome, e-mail, login e endereco.\n\nNao aceita senha - a troca possui endpoint proprio. Nao aceita tipo nem documento: sao imutaveis apos o cadastro, por decorrerem da identidade do usuario e nao de seus dados de contato.",
                "operationId": "atualizar",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AtualizarUsuarioRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Usuario atualizado",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Campos invalidos",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuario inexistente",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "E-mail ou login pertencente a outro usuario",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Exclui um usuario",
                "description": "Remove definitivamente o registro.\n\nA exclusao logica foi avaliada e descartada: manter o registro inativo preservaria o e-mail ocupado na restricao de unicidade, impedindo que a mesma pessoa se recadastrasse.",
                "operationId": "excluir",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Usuario excluido"
                    },
                    "404": {
                        "description": "Usuario inexistente",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/usuarios/{id}/senha": {
            "put": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Troca a senha do usuario",
                "description": "Endpoint exclusivo para troca de senha, separado da atualizacao dos demais dados conforme exige o enunciado.\n\n**Exige o envio da senha atual.** Trata-se de decisao de seguranca do projeto - o enunciado nao a menciona - adotada como protecao contra alteracao indevida em sessao deixada aberta.\n\nO verbo PUT foi escolhido por substituir a senha integralmente. PATCH nao consta do material da disciplina e nao se aplica: nao ha modificacao parcial de uma senha.",
                "operationId": "trocarSenha",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TrocarSenhaRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "204": {
                        "description": "Senha alterada"
                    },
                    "400": {
                        "description": "Nova senha fora das regras",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Senha atual incorreta",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "https://github.com/ThiagoWippel/fiap-adj-tech-challenge-fase-1/blob/main/README.md#credenciais-invalidas",
                                    "title": "Credenciais invalidas",
                                    "status": 401,
                                    "detail": "A senha atual informada esta incorreta",
                                    "instance": "/api/v1/usuarios/1/senha",
                                    "momento": "2026-08-21T10:30:00"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuario inexistente",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/usuarios": {
            "get": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Busca usuarios pelo nome",
                "description": "Retorna os usuarios cujo nome contem o termo informado, sem diferenciar maiusculas de minusculas. Omitindo o parametro, retorna todos.\n\nQuando nenhum usuario corresponde ao termo, a resposta e 200 com lista vazia: a colecao filtrada existe como recurso, apenas nao contem elementos.",
                "operationId": "buscarPorNome",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Termo de busca",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "maria"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista de usuarios, possivelmente vazia",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/UsuarioResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Usuarios"
                ],
                "summary": "Cadastra um novo usuario",
                "description": "Cria um usuario do tipo CLIENTE ou DONO_RESTAURANTE.\n\nO documento exigido depende do tipo: CPF para cliente, CNPJ para dono de restaurante. Ambos sao gravados apenas com digitos, sem pontuacao.\n\nE-mail, login e documento sao unicos no sistema.",
                "operationId": "cadastrar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CriarUsuarioRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Usuario cadastrado. O cabecalho Location aponta para o recurso criado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UsuarioResponse"
                                },
                                "example": {
                                    "id": 1,
                                    "nome": "Maria Silva",
                                    "email": "maria.silva@exemplo.com",
                                    "login": "maria.silva",
                                    "tipo": "CLIENTE",
                                    "documento": "12345678909",
                                    "endereco": {
                                        "rua": "Rua das Flores",
                                        "numero": "123",
                                        "complemento": "Apto 45",
                                        "bairro": "Centro",
                                        "cidade": "Camboriu",
                                        "estado": "SC",
                                        "cep": "88340000"
                                    },
                                    "dataCriacao": "2026-08-21T10:30:00",
                                    "dataUltimaAlteracao": "2026-08-21T10:30:00"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Campos invalidos ou documento incompativel com o tipo informado",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "https://github.com/ThiagoWippel/fiap-adj-tech-challenge-fase-1/blob/main/README.md#dados-invalidos",
                                    "title": "Dados invalidos",
                                    "status": 400,
                                    "detail": "Um ou mais campos da requisicao nao passaram na validacao",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-08-21T10:30:00",
                                    "erros": [
                                        {
                                            "campo": "email",
                                            "mensagem": "O e-mail informado nao e valido"
                                        },
                                        {
                                            "campo": "senha",
                                            "mensagem": "A senha deve ter entre 8 e 72 caracteres"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "E-mail, login ou documento ja cadastrado",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "https://github.com/ThiagoWippel/fiap-adj-tech-challenge-fase-1/blob/main/README.md#conflito-de-dados",
                                    "title": "Conflito de dados",
                                    "status": 409,
                                    "detail": "O e-mail informado ja esta cadastrado",
                                    "instance": "/api/v1/usuarios",
                                    "momento": "2026-08-21T10:30:00"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Autenticacao"
                ],
                "summary": "Valida as credenciais de um usuario",
                "description": "Confere se login e senha correspondem a um usuario cadastrado.\n\nO retorno traz apenas identificador, nome e tipo. Nao e uma consulta de perfil: a operacao responde se as credenciais conferem, e nao quem e o usuario.\n\n**Nota de seguranca:** a resposta de falha e identica para login inexistente e senha incorreta, tanto em mensagem quanto em tempo de processamento. Diferenciar os dois casos permitiria descobrir quais logins existem por tentativa e erro.",
                "operationId": "autenticar",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Credenciais validas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                },
                                "example": {
                                    "id": 1,
                                    "nome": "Maria Silva",
                                    "tipo": "CLIENTE"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Login ou senha ausente",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciais invalidas",
                        "content": {
                            "application/problem+json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProblemDetail"
                                },
                                "example": {
                                    "type": "https://github.com/ThiagoWippel/fiap-adj-tech-challenge-fase-1/blob/main/README.md#credenciais-invalidas",
                                    "title": "Credenciais invalidas",
                                    "status": 401,
                                    "detail": "Login ou senha invalidos",
                                    "instance": "/api/v1/auth/login",
                                    "momento": "2026-08-21T10:30:00"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/usuarios": {
            "get": {
                "tags": [
                    "Usuarios v2"
                ],
                "summary": "Busca usuarios pelo nome, com paginacao",
                "description": "Mesma consulta da versao 1, com resposta em formato distinto.\n\n**Mudanca incompativel em relacao a v1:** onde a versao anterior devolve um vetor de usuarios, esta devolve um objeto contendo o vetor no campo \"conteudo\" acompanhado dos metadados de paginacao. Um consumidor da v1 nao consegue processar esta resposta, o que caracteriza a quebra de contrato que motiva o incremento de versao.",
                "operationId": "buscarPorNome_1",
                "parameters": [
                    {
                        "name": "nome",
                        "in": "query",
                        "description": "Termo de busca",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "example": "maria"
                    },
                    {
                        "name": "paginacao",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "$ref": "#/components/schemas/Pageable"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pagina de resultados",
                        "content": {
                            "application/json": {
                                "example": {
                                    "conteudo": [
                                        {
                                            "id": 1,
                                            "nome": "Maria Silva",
                                            "email": "maria.silva@exemplo.com",
                                            "login": "maria.silva",
                                            "tipo": "CLIENTE",
                                            "documento": "12345678909",
                                            "endereco": {
                                                "rua": "Rua das Flores",
                                                "numero": "123",
                                                "complemento": "Apto 45",
                                                "bairro": "Centro",
                                                "cidade": "Camboriu",
                                                "estado": "SC",
                                                "cep": "88340000"
                                            },
                                            "dataCriacao": "2026-08-21T10:30:00",
                                            "dataUltimaAlteracao": "2026-08-21T10:30:00"
                                        }
                                    ],
                                    "pagina": 0,
                                    "tamanho": 10,
                                    "totalElementos": 1,
                                    "totalPaginas": 1,
                                    "ultima": true
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AtualizarUsuarioRequest": {
                "type": "object",
                "description": "Dados para atualizacao de um usuario existente",
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Maria Silva Souza",
                        "maxLength": 120,
                        "minLength": 3
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "maria.souza@exemplo.com",
                        "maxLength": 255,
                        "minLength": 0
                    },
                    "login": {
                        "type": "string",
                        "example": "maria.souza",
                        "maxLength": 50,
                        "minLength": 4,
                        "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "endereco": {
                        "$ref": "#/components/schemas/EnderecoRequest"
                    }
                },
                "required": [
                    "email",
                    "endereco",
                    "login",
                    "nome"
                ]
            },
            "EnderecoRequest": {
                "type": "object",
                "description": "Endereco do usuario",
                "properties": {
                    "rua": {
                        "type": "string",
                        "example": "Rua das Flores",
                        "maxLength": 150,
                        "minLength": 0
                    },
                    "numero": {
                        "type": "string",
                        "description": "Aceita valores como S/N e 123-A",
                        "example": "123",
                        "maxLength": 10,
                        "minLength": 0
                    },
                    "complemento": {
                        "type": "string",
                        "example": "Apto 45",
                        "maxLength": 60,
                        "minLength": 0
                    },
                    "bairro": {
                        "type": "string",
                        "example": "Centro",
                        "maxLength": 80,
                        "minLength": 0
                    },
                    "cidade": {
                        "type": "string",
                        "example": "Camboriu",
                        "maxLength": 80,
                        "minLength": 0
                    },
                    "estado": {
                        "type": "string",
                        "example": "SC",
                        "minLength": 1,
                        "pattern": "^[A-Za-z]{2}$"
                    },
                    "cep": {
                        "type": "string",
                        "description": "Aceita com ou sem pontuacao",
                        "example": "88340-000",
                        "minLength": 1,
                        "pattern": "^\\d{5}-?\\d{3}$"
                    }
                },
                "required": [
                    "bairro",
                    "cep",
                    "cidade",
                    "estado",
                    "numero",
                    "rua"
                ]
            },
            "ProblemDetail": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "instance": {
                        "type": "string",
                        "format": "uri"
                    },
                    "properties": {
                        "type": "object",
                        "additionalProperties": {}
                    }
                }
            },
            "EnderecoResponse": {
                "type": "object",
                "description": "Endereco do usuario",
                "properties": {
                    "rua": {
                        "type": "string"
                    },
                    "numero": {
                        "type": "string"
                    },
                    "complemento": {
                        "type": "string"
                    },
                    "bairro": {
                        "type": "string"
                    },
                    "cidade": {
                        "type": "string"
                    },
                    "estado": {
                        "type": "string"
                    },
                    "cep": {
                        "type": "string"
                    }
                }
            },
            "UsuarioResponse": {
                "type": "object",
                "description": "Dados publicos de um usuario",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "nome": {
                        "type": "string",
                        "example": "Maria Silva"
                    },
                    "email": {
                        "type": "string",
                        "example": "maria.silva@exemplo.com"
                    },
                    "login": {
                        "type": "string",
                        "example": "maria.silva"
                    },
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "CLIENTE",
                            "DONO_RESTAURANTE"
                        ],
                        "example": "CLIENTE"
                    },
                    "documento": {
                        "type": "string",
                        "description": "CPF para cliente, CNPJ para dono de restaurante",
                        "example": "12345678909"
                    },
                    "endereco": {
                        "$ref": "#/components/schemas/EnderecoResponse"
                    },
                    "dataCriacao": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-08-21T10:30:00"
                    },
                    "dataUltimaAlteracao": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-08-21T14:45:00"
                    }
                }
            },
            "TrocarSenhaRequest": {
                "type": "object",
                "description": "Dados para troca de senha",
                "properties": {
                    "senhaAtual": {
                        "type": "string",
                        "example": "SenhaAntiga123",
                        "minLength": 1
                    },
                    "novaSenha": {
                        "type": "string",
                        "example": "SenhaNova456",
                        "maxLength": 72,
                        "minLength": 8
                    }
                },
                "required": [
                    "novaSenha",
                    "senhaAtual"
                ]
            },
            "CriarUsuarioRequest": {
                "type": "object",
                "description": "Dados para cadastro de um novo usuario",
                "properties": {
                    "nome": {
                        "type": "string",
                        "example": "Maria Silva",
                        "maxLength": 120,
                        "minLength": 3
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "maria.silva@exemplo.com",
                        "maxLength": 255,
                        "minLength": 0
                    },
                    "login": {
                        "type": "string",
                        "example": "maria.silva",
                        "maxLength": 50,
                        "minLength": 4,
                        "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "senha": {
                        "type": "string",
                        "example": "SenhaSegura123",
                        "maxLength": 72,
                        "minLength": 8
                    },
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "CLIENTE",
                            "DONO_RESTAURANTE"
                        ],
                        "example": "CLIENTE"
                    },
                    "cpf": {
                        "type": "string",
                        "description": "Obrigatorio quando o tipo e CLIENTE",
                        "example": "12345678909"
                    },
                    "cnpj": {
                        "type": "string",
                        "description": "Obrigatorio quando o tipo e DONO_RESTAURANTE",
                        "example": "11222333000181"
                    },
                    "endereco": {
                        "$ref": "#/components/schemas/EnderecoRequest"
                    }
                },
                "required": [
                    "email",
                    "endereco",
                    "login",
                    "nome",
                    "senha",
                    "tipo"
                ]
            },
            "LoginRequest": {
                "type": "object",
                "description": "Credenciais para validacao de login",
                "properties": {
                    "login": {
                        "type": "string",
                        "example": "maria.silva",
                        "minLength": 1
                    },
                    "senha": {
                        "type": "string",
                        "example": "SenhaSegura123",
                        "minLength": 1
                    }
                },
                "required": [
                    "login",
                    "senha"
                ]
            },
            "LoginResponse": {
                "type": "object",
                "description": "Resultado da validacao de credenciais",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "example": 1
                    },
                    "nome": {
                        "type": "string",
                        "example": "Maria Silva"
                    },
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "CLIENTE",
                            "DONO_RESTAURANTE"
                        ],
                        "example": "CLIENTE"
                    }
                }
            },
            "Pageable": {
                "type": "object",
                "properties": {
                    "page": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 0
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32",
                        "minimum": 1
                    },
                    "sort": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
